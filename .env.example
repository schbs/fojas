# Fojas (demo): todas las variables, con valores falsos. Los valores reales van en .env.local (lo completa Germán).
# Ver qué falta sin mostrar valores: npm run check-env

# Gemini (aistudio.google.com → Get API key): embeddings (gemini-embedding-001) y respuestas.
GEMINI_API_KEY=pon-aca-tu-clave
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase (proyecto propio de Fojas, plan gratis): Project Settings → API. La clave secreta solo se usa en el servidor.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=pon-aca-la-clave-secreta
